{
  "name": "fullprep-backend",
  "version": "1.0.0",
  "description": "Production-ready backend for FullPrep SaaS platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --max-http-header-size=256000 --import ./instrument.js server.js",
    "dev": "nodemon --exec \"node --max-http-header-size=256000\" --import ./instrument.js server.js",
    "seed": "node seed.js",
    "test": "node --test src/tests/**/*.test.js",
    "lint": "eslint ."
  },
  "keywords": [
    "fullprep",
    "saas",
    "auth",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "FullPrep Team",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sentry/node": "^10.56.0",
    "@sentry/profiling-node": "^10.56.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.78.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.3.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.1",
    "razorpay": "^2.9.6",
    "validator": "^13.12.0"
  },
  "overrides": {
    "form-data": "^2.5.6"
  },
  "devDependencies": {
    "eslint": "^9.16.0",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
